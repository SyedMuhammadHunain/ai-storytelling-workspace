FROM node:20-alpine AS build

WORKDIR /app
COPY web/package*.json ./
RUN npm install
COPY web/ ./
RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY --from=build /app/dist/web ./dist
COPY docker/entrypoint-web.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["npx", "serve", "-s", "dist/browser", "-l", "3000"]
