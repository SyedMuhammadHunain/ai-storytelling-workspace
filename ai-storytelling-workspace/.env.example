# AI Storytelling Workspace Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Database Configuration (MySQL)
# ============================================================================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=storytelling_workspace
MYSQL_USER=storytelling_user
MYSQL_PASSWORD=storytelling_pass
MYSQL_PORT=3306

# Database URL for SQLAlchemy (constructed from above)
DATABASE_URL=mysql+aiomysql://storytelling_user:storytelling_pass@mysql:3306/storytelling_workspace

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_PASSWORD=redis_pass
REDIS_PORT=6379
REDIS_URL=redis://:redis_pass@redis:6379/0

# ============================================================================
# AI Provider API Keys
# ============================================================================
# Mistral AI (Primary provider for text generation)
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenAI (Fallback provider)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Application Configuration
# ============================================================================
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# phpMyAdmin
PHPMYADMIN_PORT=8080

# ============================================================================
# Storage Configuration
# ============================================================================
STORAGE_PATH=/app/storage

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_MINUTE=90000

# ============================================================================
# Cache Configuration
# ============================================================================
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# ============================================================================
# Cost Tracking
# ============================================================================
# Mistral Pricing (per 1M tokens)
MISTRAL_INPUT_COST=0.25
MISTRAL_OUTPUT_COST=0.75

# OpenAI Pricing (per 1M tokens)
OPENAI_INPUT_COST=0.50
OPENAI_OUTPUT_COST=1.50

# Pixtral Image Pricing (per image)
PIXTRAL_IMAGE_COST=0.04

# ============================================================================
# Image Generation Configuration
# ============================================================================
IMAGE_PROVIDER=pixtral
IMAGE_MODEL=pixtral-12b-2409

# Image sizes
COVER_ART_SIZE=1024x1024
CHARACTER_PORTRAIT_SIZE=512x512
SCENE_ILLUSTRATION_SIZE=1024x512

# ============================================================================
# Workflow Configuration
# ============================================================================
CHECKPOINT_ENABLED=true
AUTO_APPROVE_CHECKPOINTS=false

# ============================================================================
# Security
# ============================================================================
SECRET_KEY=your_secret_key_here_change_in_production
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# Monitoring & Observability
# ============================================================================
ENABLE_METRICS=true
ENABLE_TRACING=false

# ============================================================================
# Development Settings
# ============================================================================
# Set to true to enable hot reload in development
RELOAD=true

# Set to true to enable detailed SQL logging
SQL_ECHO=false
